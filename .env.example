# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://saas:saas@localhost:5432/saas_db

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional - remove unused blocks)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Inngest
INNGEST_APP_ID=my-saas-app
# Production only (Inngest runs unsigned in development): shared secrets between
# this app and the self-hosted Inngest server. Generate each with: openssl rand -hex 32
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Read by the browser (Inngest Realtime WebSocket, used by /demo/inngest) -
# must be a URL the browser can actually reach. Docker deployments: this
# can't be the Docker-internal `http://inngest:8288` hostname - expose the
# Inngest server through your reverse proxy and point this at that public URL.
NEXT_PUBLIC_INNGEST_BASE_URL=http://localhost:8288

# AI (optional - used for background AI jobs)
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL=google/gemini-2.5-flash

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Polar (payments - leave all four unset to disable and mock premium access locally)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SUCCESS_URL=http://localhost:3000/dashboard
POLAR_SERVER=sandbox

# Resend (transactional email - password reset + email verification)
# Leave both unset to log emails to the console instead of sending them (local dev)
RESEND_API_KEY=
EMAIL_FROM=Acme <noreply@example.com>

# Plausible Analytics (optional - leave unset to disable, no tracking script is rendered)
# Site-specific script URL from your Plausible dashboard (self-hosted or plausible.io)
NEXT_PUBLIC_PLAUSIBLE_SRC=https://analytics.example.com/js/script.js

# Sentry (optional - leave NEXT_PUBLIC_SENTRY_DSN unset to disable error tracking)
# The DSN is inlined into the browser bundle at build time (Docker: passed as a build arg).
NEXT_PUBLIC_SENTRY_DSN=
# Share of requests that are traced, 0 to 1 (default: 1 in development, 0.1 in production).
# Also inlined into the browser bundle at build time (Docker: build arg).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Only needed to upload source maps during `next build`
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Set to 1 to record AI prompts and model outputs in Sentry traces (may contain personal data, off by default)
SENTRY_RECORD_AI_DATA=

# Seed script (optional - `bun run db:seed` seeds this user, or every user when unset)
SEED_USER_EMAIL=test@test.com
